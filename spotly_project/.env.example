# Django
DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DEBUG=1
ALLOWED_HOSTS=127.0.0.1,localhost

# Database: sqlite is easiest for development. Set DB_ENGINE=mysql for MySQL.
DB_ENGINE=sqlite
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Google OAuth - create credentials in Google Cloud Console.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Authorized redirect URI: http://127.0.0.1:8000/auth/google/callback/

# Email for production password reset. Leave blank to use console email locally.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Spotly <no-reply@example.com>
